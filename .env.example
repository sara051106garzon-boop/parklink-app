# ---------------------------------------------------------------------------
# Este archivo NO es leído automáticamente por Flutter.
# Es una referencia de las variables que usa el proyecto.
#
# IMPORTANTE (web en Vercel): NO necesitas definir API_BASE_URL para web.
# La app usa Uri.base.origin (https://parklink-app.vercel.app) y Vercel reenvía
# /api/* al back-end de EC2 mediante vercel.json. Así no hay Mixed Content ni CORS.
#
# API_BASE_URL queda como OVERRIDE opcional, por ejemplo para builds móviles,
# de escritorio, o desarrollo local directo:
#   flutter run --dart-define=API_BASE_URL=http://127.0.0.1:5000
#   flutter build web --release --dart-define=API_BASE_URL=http://3.138.221.70:8001
#
# No agregues tokens ni contraseñas aquí.
# ---------------------------------------------------------------------------

# Desarrollo local (web / escritorio): back-end local de ParkLink
# API_BASE_URL=http://127.0.0.1:5000

# Emulador Android (el host de la máquina se ve como 10.0.2.2)
# API_BASE_URL=http://10.0.2.2:5000

# Acceso directo al back-end de EC2 (solo para móvil/escritorio o pruebas)
# API_BASE_URL=http://3.138.221.70:8000   # staging
# API_BASE_URL=http://3.138.221.70:8001   # production
